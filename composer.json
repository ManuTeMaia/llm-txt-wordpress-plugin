{
  "name": "manutemaia/llms-txt",
  "description": "WordPress plugin that serves llms.txt and llms-full.txt.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5",
    "wp-coding-standards/wpcs": "^3.1",
    "phpstan/phpstan": "^2.0"
  },
  "autoload": {
    "psr-4": {
      "LlmsTxt\\": "includes/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": false
    }
  }
}
